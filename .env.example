# Copy to .env and fill in. Never commit the real .env (PRD §6 rule 2).
# ARK_API_KEY: from Volcano Ark console
ARK_API_KEY=

# OpenAI-compatible Ark endpoint.
# MUST be the /api/plan/... one when you subscribe to the Agent/Coding Plan:
# the console warns that https://ark.cn-beijing.volces.com/api/v3 bypasses the
# subscription and bills separately (silently — nothing fails, you just pay).
# /api/plan (no /v3) is the Anthropic-protocol variant for Claude Code etc.;
# this project speaks OpenAI, so it is not what we want.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# Model IDs: verify against the console, then confirm with a real call via
# `make embed-test` before first sync (M0 / AC-001).
EMBED_MODEL=
CHAT_MODEL=
