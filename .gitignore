# Runtime data & secrets: permanently ignored, never committed (PRD §6 rule 2)
.env
data/
notes/

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Quality-metric artifacts (regenerated by make cov / make mutation)
.coverage
coverage.xml
mutants/
.mutmut-cache

# 门禁自检临时仓库（make gate-selftest 建的，跑完即删）
.gate-selftest/

# AI / agent working directory (session memory, not project source)
.workbuddy-ai/
# 工具运行时状态（hook 的会话续跑标记）。它每次运行都会变，进版本库只会让
# 每次 git status 都脏一行，而且别人 pull 到的是你本机的会话状态 —— 纯噪声。
.mimosa/

# macOS
.DS_Store

# 前端工程（v0.9）：依赖与**构建产物**都不入库（与 .venv / coverage.xml 同规矩）；
# 类型快照 src/api/schema.d.ts 相反 —— 它入库（那是契约，见 ADR-21 决策 8）。
web/node_modules/
web/dist/
# Playwright 的产物（失败截图/追踪/上次运行标记）：本地产物，不入库。
web/test-results/
web/playwright-report/
# pnpm 在某些环境会在仓库内落一个本地 store 存根；依赖缓存不该进版本库。
.pnpm-store/
# 由 `make ui-types` 生成、只作为 openapi-typescript 的输入；类型快照才是入库的那份。
web/openapi.json
